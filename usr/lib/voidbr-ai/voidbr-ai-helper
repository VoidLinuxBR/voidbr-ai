#!/usr/bin/env bash
#
#   voidbr-ai-helper - ações privilegiadas do VoidBR AI (lista branca)
#   Created: ter 29 set 2026 23:00:00 -04
#   Updated: qua 30 set 2026 19:40:00 -04
#
