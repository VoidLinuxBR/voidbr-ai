#   Assembled By Vilmar Catafesta for the VoidBR project.
#   Licença: MIT
#
#   Chamado pelo VoidBR AI via pkexec (polkit: org.voidbr.ai.helper).
#   NÃO é um shell: só aceita os verbos abaixo e valida cada argumento.
#   O LLM nunca chega aqui diretamente; só depois que o usuário confirma.
#
#   Opção (antes do verbo):
#     --snapshot DESCRIÇÃO              antes de ações de risco, cria um snapshot com o
#                                       voidbr-snapper-manager (se instalado e configurado).
#                                       Nas ações do xbps com os hooks do snapper instalados,
#                                       o próprio hook cria o par pre/post: aqui só informa
#                                       o número. Imprime "SNAPSHOT: N".
#
#   Verbos:
#     service-start|stop|restart NOME   sv start|stop|restart NOME
#     service-enable  NOME              ln -s /etc/sv/NOME /var/service/ && sv start NOME
#     service-disable NOME              sv stop NOME && rm /var/service/NOME
#     service-status  NOME              sv status NOME (só leitura, para verificar)
#     link-up         IFACE             ip link set IFACE up
#     rfkill-unblock  wlan|bluetooth    desbloqueia (software) os rádios do tipo
#     nm-networking-on                  nmcli networking on
#     nm-wifi-on                        nmcli radio wifi on
#     pkg-install     PACOTE...         xbps-install -Sy PACOTE...
#     pkg-remove      PACOTE...         xbps-remove -y PACOTE...
#     system-update                     xbps-install -Syu xbps && xbps-install -yu
#     pkg-clean-cache                   xbps-remove -yO
#     pkg-remove-orphans                xbps-remove -yo
#     kernel-purge                      vkpurge rm all
#     pipewire-conf   wireplumber|pulse ln -s <exemplo do Void> /etc/pipewire/pipewire.conf.d/
#     kernel-reconfigure PACOTE         xbps-reconfigure -f linuxX.Y (refaz o initramfs)
#     grub-update                       update-grub
#     limine-update                     update-limine (se existir)
#     groups-add      GRUPO             gpasswd -a <usuário que chamou> GRUPO (lista fechada)
#     printer-add     NOME URI          lpadmin -p NOME -E -v URI -m everywhere (sem driver)
#     printer-enable  NOME              cupsenable NOME && cupsaccept NOME
#     printer-cancel-jobs NOME          cancel -a NOME
#
#   ChangeLog:
#   - 2026-09-30: impressoras: printer-add, printer-enable, printer-cancel-jobs; grupo lpadmin.
#   - 2026-09-30: --snapshot (voidbr-snapper-manager); kernel-reconfigure, grub-update,
#     limine-update, groups-add.
#   - 2026-09-30: qualquer serviço de /etc/sv; pacotes (instalar, remover,
#     atualizar, limpar cache, órfãos); kernels antigos; rfkill bluetooth.
#

set -uo pipefail
export PATH=/usr/bin:/usr/sbin:/bin:/sbin
export LC_ALL=C

readonly sv_dir="/etc/sv"
readonly service_dir="/var/service"

# pacotes que nunca são removidos por aqui
readonly protected_pkgs=(base-system base-files base-container base-minimal xbps voidbr-xbps
	runit runit-void glibc musl linux linux-base bash coreutils shadow sudo util-linux
	eudev dbus polkit voidbr-ai)

red='\e[1;31m'
green='\e[1;32m'
reset='\e[0m'
[[ -t 1 ]] || { red=''; green=''; reset=''; }

die() { printf '%bERRO:%b %s\n' "$red" "$reset" "$*" >&2; exit 1; }
ok()  { printf '%bOK:%b %s\n' "$green" "$reset" "$*"; }

[[ $EUID -eq 0 ]] || die "precisa rodar como root (via pkexec)"

need_service() {
	[[ -n ${1:-} ]] || die "informe o serviço"
	[[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9_.@-]{0,63}$ ]] || die "nome de serviço inválido: $1"
	[[ -d $sv_dir/$1 ]] || die "serviço não instalado: $sv_dir/$1 não existe"
}

valid_iface() {
	[[ $1 =~ ^[A-Za-z0-9_.:-]{1,15}$ ]] && [[ -e /sys/class/net/$1 ]]
}

need_pkgs() {
	(($# > 0)) || die "informe ao menos um pacote"
	(($# <= 20)) || die "no máximo 20 pacotes por vez"
	local p
	for p in "$@"; do
		[[ $p =~ ^[A-Za-z0-9][A-Za-z0-9._+-]{0,99}$ ]] || die "nome de pacote inválido: $p"
	done
}

need_printer() {
	[[ ${1:-} =~ ^[A-Za-z0-9_-]{1,64}$ ]] || die "nome de impressora inválido: ${1:-}"
}

# o runsvdir leva alguns segundos para assumir um serviço recém-habilitado
wait_supervise() {
	local i
	for ((i = 0; i < 20; i++)); do
		[[ -e $service_dir/$1/supervise/ok ]] && return 0
		sleep 0.5
	done
	return 1
}

# ---------------------------------------------------------------------------
# snapshot antes de ações de risco (voidbr-snapper-manager)
# ---------------------------------------------------------------------------
readonly snapper_mgr=/usr/bin/voidbr-snapper-manager
readonly snapper_hook=/etc/xbps.d/hooks.d/00-voidbr-snapper-pre.hook
snap_desc=""
snap_after=0

# último snapshot "pre" (criado pelo hook do xbps nesta transação)
snapshot_latest_pre() {
	local n
	n=$("$snapper_mgr" list --csv 2>/dev/null | awk -F, '$2 == "pre" { n = $1 } END { if (n != "") print n }')
	[[ $n =~ ^[0-9]+$ ]] && echo "SNAPSHOT: $n"
}

snapshot_before() {
	local verb=$1 out n
	[[ -x $snapper_mgr ]] || { echo "snapshot: voidbr-snapper-manager não instalado; seguindo sem snapshot"; return 0; }
	case $verb in
	pkg-install | pkg-remove | system-update | pkg-remove-orphans)
		if [[ -f $snapper_hook ]]; then
			snap_after=1    # o hook do xbps cria o par pre/post
			return 0
		fi
		;;
	esac
	if out=$("$snapper_mgr" create "$snap_desc" 2>&1); then
		n=$(tail -n1 <<<"$out")
		[[ $n =~ ^[0-9]+$ ]] && echo "SNAPSHOT: $n"
	else
		echo "snapshot: não foi possível criar ($(tail -n1 <<<"$out")); seguindo sem snapshot"
	fi
}

if [[ ${1:-} == --snapshot ]]; then
	snap_desc=${2:-}
	[[ $snap_desc =~ ^[A-Za-z0-9\ ._:/()+,-]{1,80}$ ]] || die "descrição de snapshot inválida"
	shift 2 || die "falta a descrição do snapshot"
fi

verb=${1:-}
shift || true

case $verb in
pkg-install | pkg-remove | system-update | pkg-remove-orphans | kernel-purge | kernel-reconfigure | grub-update | limine-update)
	[[ -n $snap_desc ]] && snapshot_before "$verb"
	;;
esac

# no fim de qualquer verbo que deu certo, informa o snapshot do hook
trap '[[ $? -eq 0 && $snap_after -eq 1 ]] && snapshot_latest_pre' EXIT

case $verb in
service-start | service-stop | service-restart)
	need_service "${1:-}"
	[[ -e $service_dir/$1 ]] || die "$1 não está habilitado em $service_dir"
	sv "${verb#service-}" "$service_dir/$1" || die "sv ${verb#service-} $1 falhou"
	ok "sv ${verb#service-} $1"
	;;
service-status)
	need_service "${1:-}"
	[[ -e $service_dir/$1 ]] || { echo "disabled: $1"; exit 0; }
	sv status "$service_dir/$1"
	;;
service-enable)
	need_service "${1:-}"
	if [[ ! -e $service_dir/$1 ]]; then
		ln -s "$sv_dir/$1" "$service_dir/" || die "não foi possível habilitar $1"
		ok "habilitado: $service_dir/$1 -> $sv_dir/$1"
	fi
	wait_supervise "$1" || die "o runsvdir não assumiu $1 (runsvdir rodando?)"
	sv start "$service_dir/$1" || die "sv start $1 falhou"
	ok "sv start $1"
	;;
service-disable)
	need_service "${1:-}"
	[[ -L $service_dir/$1 ]] || die "$1 não está habilitado (ou não é um link) em $service_dir"
	sv stop "$service_dir/$1" || true
	rm -f "$service_dir/$1" || die "não foi possível remover $service_dir/$1"
	ok "desabilitado: $1 (para voltar: ln -s $sv_dir/$1 $service_dir/)"
	;;
link-up)
	valid_iface "${1:-}" || die "interface inválida: ${1:-}"
	ip link set "$1" up || die "ip link set $1 up falhou"
	ok "ip link set $1 up"
	;;
rfkill-unblock)
	[[ ${1:-} == wlan || ${1:-} == bluetooth ]] || die "tipo inválido: ${1:-} (wlan|bluetooth)"
	found=0
	for d in /sys/class/rfkill/rfkill*; do
		[[ -r $d/type && $(<"$d/type") == "$1" ]] || continue
		found=1
		echo 0 >"$d/soft" || die "não foi possível desbloquear $(<"$d/name")"
		ok "desbloqueado: $(<"$d/name")"
	done
	((found)) || die "nenhum rádio $1 em /sys/class/rfkill"
	;;
nm-networking-on)
	nmcli networking on || die "nmcli networking on falhou"
	ok "nmcli networking on"
	;;
nm-wifi-on)
	nmcli radio wifi on || die "nmcli radio wifi on falhou"
	ok "nmcli radio wifi on"
	;;
pkg-install)
	need_pkgs "$@"
	xbps-install -Sy -- "$@" || die "xbps-install falhou"
	ok "instalado: $*"
	;;
pkg-remove)
	need_pkgs "$@"
	for p in "$@"; do
		for q in "${protected_pkgs[@]}"; do
			[[ $p == "$q" ]] && die "o pacote $p é essencial e não pode ser removido por aqui"
		done
	done
	xbps-remove -y -- "$@" || die "xbps-remove falhou (algum pacote instalado depende deles?)"
	ok "removido: $*"
	;;
system-update)
	# o próprio xbps precisa ser atualizado antes do resto
	xbps-install -Sy -u xbps || die "falha ao sincronizar/atualizar o xbps"
	xbps-install -yu || die "xbps-install -u falhou"
	ok "sistema atualizado"
	;;
pkg-clean-cache)
	xbps-remove -yO || die "xbps-remove -O falhou"
	ok "cache do xbps limpo (pacotes obsoletos)"
	;;
pkg-remove-orphans)
	xbps-remove -yo || die "xbps-remove -o falhou"
	ok "pacotes órfãos removidos"
	;;
kernel-purge)
	command -v vkpurge >/dev/null || die "vkpurge não encontrado (pacote base-files)"
	vkpurge rm all || die "vkpurge falhou"
	ok "kernels antigos removidos"
	;;
pipewire-conf)
	case ${1:-} in
	wireplumber) src=/usr/share/examples/wireplumber/10-wireplumber.conf ;;
	pulse) src=/usr/share/examples/pipewire/20-pipewire-pulse.conf ;;
	*) die "parte inválida: ${1:-} (wireplumber|pulse)" ;;
	esac
	[[ -f $src ]] || die "$src não existe (pacote ${1/pulse/pipewire} instalado?)"
	mkdir -p /etc/pipewire/pipewire.conf.d || die "não foi possível criar /etc/pipewire/pipewire.conf.d"
	ln -sf "$src" /etc/pipewire/pipewire.conf.d/ || die "não foi possível criar o link"
	ok "ativado: /etc/pipewire/pipewire.conf.d/${src##*/}"
	;;
kernel-reconfigure)
	[[ ${1:-} =~ ^linux[0-9]+\.[0-9]+$ ]] || die "pacote de kernel inválido: ${1:-} (ex: linux6.12)"
	xbps-query "$1" >/dev/null 2>&1 || die "$1 não está instalado"
	xbps-reconfigure -f "$1" || die "xbps-reconfigure -f $1 falhou"
	ok "reconfigurado: $1 (initramfs refeito)"
	;;
grub-update)
	command -v update-grub >/dev/null || die "update-grub não encontrado (pacote grub)"
	update-grub || die "update-grub falhou"
	ok "menu do GRUB atualizado"
	;;
limine-update)
	cmd=""
	for c in /usr/local/bin/update-limine /usr/bin/update-limine /usr/bin/limine-update; do
		[[ -x $c ]] && { cmd=$c; break; }
	done
	[[ -n $cmd ]] || die "nenhum update-limine encontrado"
	"$cmd" || die "$cmd falhou"
	ok "menu do Limine atualizado"
	;;
groups-add)
	case ${1:-} in
	audio | video | render | input | bluetooth | socklog | _seatd | network | plugdev | lpadmin) ;;
	*) die "grupo não permitido: ${1:-}" ;;
	esac
	getent group "$1" >/dev/null || die "o grupo $1 não existe"
	[[ -n ${PKEXEC_UID:-} ]] || die "usuário que chamou desconhecido (rode via pkexec)"
	user=$(getent passwd "$PKEXEC_UID" | cut -d: -f1)
	[[ -n $user && $PKEXEC_UID -ne 0 ]] || die "usuário inválido"
	gpasswd -a "$user" "$1" || die "não foi possível adicionar $user ao grupo $1"
	ok "$user adicionado ao grupo $1 (vale a partir do próximo login)"
	;;
printer-add)
	need_printer "${1:-}"
	re_uri='^ipps?://[][A-Za-z0-9._~:/?#@%+=,-]{1,200}$'
	[[ ${2:-} =~ $re_uri ]] || die "URI inválido: ${2:-} (só ipp:// ou ipps://)"
	command -v lpadmin >/dev/null || die "lpadmin não encontrado (pacote cups)"
	lpstat -v "$1" >/dev/null 2>&1 && die "já existe uma impressora chamada $1"
	lpadmin -p "$1" -E -v "$2" -m everywhere || die "lpadmin falhou (a impressora está ligada e aceita IPP Everywhere?)"
	ok "impressora $1 adicionada ($2)"
	;;
printer-enable)
	need_printer "${1:-}"
	lpstat -v "$1" >/dev/null 2>&1 || die "a impressora $1 não existe no CUPS"
	cupsenable "$1" || die "cupsenable $1 falhou"
	cupsaccept "$1" || die "cupsaccept $1 falhou"
	ok "impressora $1 reativada"
	;;
printer-cancel-jobs)
	need_printer "${1:-}"
	lpstat -v "$1" >/dev/null 2>&1 || die "a impressora $1 não existe no CUPS"
	cancel -a "$1" || die "cancel -a $1 falhou"
	ok "fila de $1 limpa"
	;;
*)
	die "verbo não permitido: ${verb:-<vazio>}"
	;;
esac
