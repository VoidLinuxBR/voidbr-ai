pkgname=voidbr-ai
pkgdesc="VoidBR AI - assistente do sistema: investiga a máquina real, explica e corrige com confirmação (GTK4 + CLI)"
pkgver=0.3.7   # = APP_VERSION (usr/lib/voidbr-ai/voidbr_ai/__init__.py); atualizar a cada release
pkgrel=1
arch=('any')
license=('MIT')
#url="ssh://git@github.com/voidlinuxbr/${pkgname}"
url="https://github.com/voidlinuxbr/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')
makedepends=()
depends=(
	'python3'         # >= 3.11 (tomllib)
	'python3-gobject' # GUI
	'gtk4'            # GUI (Gtk.AlertDialog: GTK >= 4.10)
	'polkit'          # pkexec para as ações confirmadas
	'iproute2'        # ip -j link/addr/route
	'iputils'         # ping
	'iw'              # estado do Wi-Fi
)
# opcionais (detectados em tempo de execução, não são dependência):
#   voidbr-ollama   -> IA local (o assistente instala: voidbr-ai --setup-ai)
#   voidbr-snapper-manager -> snapshot antes das ações de risco, com "Desfazer"
#   libnotify (notify-send) -> avisos em segundo plano (voidbr-ai --monitor)
#   xtools (xlocate) -> citado nas explicações de erro
#   cups, cups-filters, avahi, nss-mdns, ipp-usb, drivers -> o diagnóstico de impressora instala
#   NetworkManager / iwd / connman / dhcpcd / wpa_supplicant, pipewire/wireplumber,
#   bluez, socklog-void -> o que o usuário usar
# já fazem parte do base-system do Void: pciutils (lspci), usbutils (lsusb),
#   base-files (vkpurge), xbps

backup=(
	'/etc/voidbr-ai/config.toml'
)

package() {
	# Verify default folder
	if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}/${pkgname}"
	elif [ -d "${srcdir}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}"
	else
		#local
		InternalDir="${WORKDIR}"
	fi

	cd "${InternalDir}"
	# Copiar a estrutura de /etc, /usr e /opt para /
	local dirs=("boot" "etc" "opt" "usr" "var")
	for dir in "${dirs[@]}"; do
		if [ -d "${InternalDir}/${dir}" ]; then
			cp -a "${InternalDir}/${dir}" "${pkgdir}/"
		fi
	done

	# executáveis (o git pode não preservar o bit +x em todos os fluxos)
	chmod 755 "${pkgdir}/usr/bin/voidbr-ai" \
		"${pkgdir}/usr/bin/voidbr-ai-gui" \
		"${pkgdir}/usr/lib/voidbr-ai/voidbr-ai-helper"

	# sem bytecode/caches do repositório
	find "${pkgdir}/usr/lib/voidbr-ai" -name '__pycache__' -type d -prune -exec rm -rf {} +

	# Install license file if present
	if [ -f "LICENSE" ]; then
		install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	fi

	# Install documentation if present
	if [ -f "README.md" ]; then
		install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
	fi
}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	log "Finalizando instalação"
	echo "==> voidbr-ai instalado."
	echo "    Interface gráfica: voidbr-ai-gui"
	echo "    Terminal:          voidbr-ai \"sua pergunta\"  |  voidbr-ai --checkup"
	echo "    IA local:          voidbr-ai --setup-ai  (ou ☰ → Configurar IA local)"
	echo "    As correções rodam via pkexec: tenha um agente polkit rodando"
	echo "    (no Hyprland, ex: hyprpolkitagent)."
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	log "Finalizando upgrade"
}
